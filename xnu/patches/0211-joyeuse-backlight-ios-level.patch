+
+/*
+ * 0211: the iOS brightness (SweetFramebuffer.cpp, from backboardd's property writes). CoreBrightness ramps the
+ * level in many small steps: they are coalesced into one WLED write per SM_BL_IOS_MS, from a thread call (never
+ * from the caller's thread, never while the display is off with sweetblsleep=1).
+ */
+#define SM_BL_MIN       40      /* ~1% of the WLED current: dim but never dark while the display is on */
+#define SM_BL_IOS_MS    30
+
+static thread_call_t sm_bl_call;
+static int sm_bl_pending;
+static unsigned sm_bl_ios_count;
+
+static void
+sm_bl_ios_apply(thread_call_param_t p0, thread_call_param_t p1)
+{
+#pragma unused(p0, p1)
+	lck_mtx_lock(&sm_bl_mtx);
+	sm_bl_pending = 0;
+	int level = sm_bl_level;
+	if (sm_bl_on && level != sm_bl_written) {
+		sm_bl_quiet = 1;
+		int e = sm_bl_apply_unlocked((unsigned)level);
+		sm_bl_quiet = 0;
+		if (++sm_bl_ios_count <= 16 || (sm_bl_ios_count % 32) == 0 || e) {
+			printf("SWEET BL: iOS level %d -> %d (update %u)\n", level, e, sm_bl_ios_count);
+		}
+	}
+	lck_mtx_unlock(&sm_bl_mtx);
+}
+
+void sweet_backlight_set(int level);
+void
+sweet_backlight_set(int level)
+{
+	if (level < SM_BL_MIN) {
+		level = SM_BL_MIN;
+	}
+	if (level > 4095) {
+		level = 4095;
+	}
+	lck_mtx_lock(&sm_bl_mtx);
+	sm_bl_level = level;            /* also the level the next display on restores */
+	if (sm_bl_call != NULL && !sm_bl_pending) {
+		uint64_t deadline;
+		sm_bl_pending = 1;
+		clock_interval_to_deadline(SM_BL_IOS_MS, NSEC_PER_MSEC, &deadline);
+		(void)thread_call_enter_delayed(sm_bl_call, deadline);
 	}
+	lck_mtx_unlock(&sm_bl_mtx);
 }
 
 static int
@@ -4745,6 +4821,7 @@ sweet_modem_start(void)
 		PE_halt_restart = sweet_halt_restart;   /* power off / restart from iOS (Settings, slider) */
 	}
 	sm_rtc_sync();
+	sm_bl_call = thread_call_allocate(sm_bl_ios_apply, NULL);
 	/* 0195: boot-arg sweetbright=<percent> from the UEFI menu's control centre. 0210: here, not in sm_thread, which
 	 * only runs with sweetmodem!=0 (and only 70 s into the boot) */
