+/* 0211: one WLED writer at a time (display power, iOS brightness thread call, sysctl, boot-arg) */
+static LCK_GRP_DECLARE(sm_bl_grp, "sweet_bl");
+static LCK_MTX_DECLARE(sm_bl_mtx, &sm_bl_grp);
+
+static int
+sm_bl_apply(unsigned level)
+{
+	lck_mtx_lock(&sm_bl_mtx);
+	int e = sm_bl_apply_unlocked(level);
+	lck_mtx_unlock(&sm_bl_mtx);
+	return e;
+}
