+/* 0221: one PMIC register for bsd/dev/sweet_usb.c (it logs the USB PHY supplies on a cold bring-up) */
+int sweet_pmic_read(uint16_t ppid, uint8_t addr, uint8_t *out);
+
+int
+sweet_pmic_read(uint16_t ppid, uint8_t addr, uint8_t *out)
+{
+	if (sp_init()) {
+		return ENOMEM;
+	}
+	uint16_t apid = sp_find_apid(ppid);
+	return apid == SP_NO_APID ? ENOENT : sp_read(apid, addr, out);
+}
