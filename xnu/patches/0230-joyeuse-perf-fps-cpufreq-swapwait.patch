diff --git a/osfmk/arm64/sweet_cpufreq.c b/osfmk/arm64/sweet_cpufreq.c
new file mode 100644
index 0000000..216372c
--- /dev/null
+++ b/osfmk/arm64/sweet_cpufreq.c
@@ -0,0 +1,247 @@
+/*
+ * CPU clocks of SM7125 "atoll" (cpu0-5 Cortex-A55 = OSM "pwrcl", cpu6-7 Cortex-A76 = OSM "perfcl").
+ *
+ * Nothing else in this kernel touches the OSM, so the cores run at whatever the boot loader left.
+ * Always (no MMIO, no boot-arg): measure each cluster's real clock with a chain of dependent ADDs
+ * (1 cycle each on A55 and A76) timed by the architected timer, bound to one CPU of the cluster,
+ * interrupts off for < 3 ms; log it at boot and every sweetcpufreq_log seconds (default 30, 0 = once):
+ *   SWEET CPUFREQ: boot: A55 cpu0 1708 MHz (midr 0x51df805e), A76 cpu6 1804 MHz (midr 0x51df804e)
+ *
+ * sweetcpufreq=1 also reads the OSM look-up tables and the LMh limits and asks both clusters for their
+ * highest non-boost perf state; sweetcpufreq=2 also the L3; sweetcpufreq_ro=1 only reads and logs.
+ * The OSM is set up by the boot firmware (voltage, CPR, LMh included): like Linux on atoll
+ * (drivers/clk/qcom/clk-cpu-osm.c, osm_set_index), the OS only writes a LUT index to the
+ * DCVS_PERF_STATE_DESIRED register of each core. The hardware LMh (thermal/current limits, enabled by
+ * firmware on atoll: no qcom,legacy-lmh-enable in the DT) still caps the clock; its current cap is
+ * logged. There is no software thermal governor here: nothing lowers the clock again but LMh.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <stdbool.h>
+#include <stdint.h>
+#include <mach/mach_time.h>
+#include <kern/clock.h>
+#include <kern/cpu_number.h>
+#include <kern/kern_types.h>
+#include <kern/misc_protos.h>
+#include <kern/processor.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <arm/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+void sweet_cpufreq_start(void);
+
+/* dt: qcom,cpucc@18321000 (qcom,clk-cpu-osm-atoll), reg-names osm_l3_base, osm_pwrcl_base, osm_perfcl_base */
+#define OSM_L3_PA               0x18321000ULL
+#define OSM_PWRCL_PA            0x18323000ULL
+#define OSM_PERFCL_PA           0x18325800ULL
+#define OSM_SIZE                0x1400
+#define OSM_TABLE_SIZE          40
+#define OSM_FREQ_REG(i)         (0x110 + 32 * (i))      /* [31:30] source (0: 300 MHz), [18:16] cores, [7:0] x 19.2 MHz */
+#define OSM_VOLT_REG(i)         (0x114 + 32 * (i))      /* [21:16] virtual corner, [11:0] open-loop mV */
+#define OSM_ENABLE_REG          0x0
+#define OSM_CORE_DCVS_CTRL      0xbc                    /* bit 0: one perf-state request per core */
+#define OSM_PERF_STATE(n)       (0x920 + 4 * (n))       /* DCVS_PERF_STATE_DESIRED_REG(core) = LUT index */
+/* dt: qcom,limits-dcvs@18358800 (affinity 0, cpu0-5) and @18350800 (affinity 1, cpu6-7); Linux msm_lmh_dcvs.c */
+#define LMH_SIZE                0x1000
+#define LMH_CAP                 0x704                   /* LIMITS_CLUSTER_REQ_OFFSET: [9:0] x 19.2 MHz */
+
+#define SPIN_ITERS              10000ULL
+#define SPIN_ADDS               64ULL
+
+struct sweet_osm {
+	const char  *name;
+	uint64_t     osm_pa, lmh_pa;
+	unsigned     cores;          /* per-core perf-state registers */
+	bool         per_core;
+	bool         boost_rows;     /* LUT rows for one core only are boost (CPU clusters, not L3) */
+	vm_offset_t  osm, lmh;
+	unsigned     entries, top;
+	uint32_t     top_mhz;
+	int          cpu;            /* a logical CPU of the cluster, -1 = none */
+};
+
+static struct sweet_osm sweet_osm[3] = {
+	{ .name = "A55", .osm_pa = OSM_PWRCL_PA, .lmh_pa = 0x18358800ULL, .cores = 6, .boost_rows = true, .cpu = -1 },
+	{ .name = "A76", .osm_pa = OSM_PERFCL_PA, .lmh_pa = 0x18350800ULL, .cores = 2, .boost_rows = true, .cpu = -1 },
+	{ .name = "L3", .osm_pa = OSM_L3_PA, .cores = 1, .cpu = -1 },
+};
+static int sweet_cpufreq_mode, sweet_cpufreq_ro;
+
+static uint32_t
+rd32(vm_offset_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+static void
+wr32(vm_offset_t a, uint32_t v)
+{
+	*(volatile uint32_t *)a = v;
+}
+
+/* SPIN_ITERS x SPIN_ADDS dependent adds: as many core cycles (+ about 2 % loop overhead on the A55). */
+static void
+sweet_cpufreq_spin(void)
+{
+	uint64_t acc = 0, n = SPIN_ITERS;
+
+	__asm__ volatile (
+                "1:\n"
+                ".rept 64\n"
+                "add %0, %0, #1\n"
+                ".endr\n"
+                "subs %1, %1, #1\n"
+                "b.ne 1b\n"
+                : "+r" (acc), "+r" (n) : : "cc");
+}
+
+/* MHz of `cpu`, best of 3 runs (an interrupt-free run cannot be slower than the clock). */
+static uint32_t
+sweet_cpufreq_measure(int cpu, uint64_t *midr)
+{
+	processor_t p = cpu >= 0 ? cpu_to_processor(cpu) : PROCESSOR_NULL;
+	uint32_t best = 0;
+
+	*midr = 0;
+	if (p == PROCESSOR_NULL) {
+		return 0;
+	}
+	thread_bind(p);
+	thread_block(THREAD_CONTINUE_NULL);
+	if (cpu_number() == cpu) {
+		*midr = __builtin_arm_rsr64("MIDR_EL1");
+		for (int run = 0; run < 3; run++) {
+			boolean_t istate = ml_set_interrupts_enabled(FALSE);
+			uint64_t t0 = mach_absolute_time();
+			sweet_cpufreq_spin();
+			uint64_t t1 = mach_absolute_time();
+			ml_set_interrupts_enabled(istate);
+			uint64_t ns;
+			absolutetime_to_nanoseconds(t1 - t0, &ns);
+			uint32_t mhz = ns != 0 ? (uint32_t)(SPIN_ITERS * SPIN_ADDS * 1000ULL / ns) : 0;
+			if (mhz > best) {
+				best = mhz;
+			}
+		}
+	}
+	thread_bind(PROCESSOR_NULL);
+	thread_block(THREAD_CONTINUE_NULL);
+	return best;
+}
+
+static void
+sweet_cpufreq_report(const char *when)
+{
+	uint64_t m0, m1;
+	uint32_t a55 = sweet_cpufreq_measure(sweet_osm[0].cpu, &m0);
+	uint32_t a76 = sweet_cpufreq_measure(sweet_osm[1].cpu, &m1);
+
+	printf("SWEET CPUFREQ: %s: A55 cpu%d %u MHz (midr 0x%llx), A76 cpu%d %u MHz (midr 0x%llx)\n",
+	    when, sweet_osm[0].cpu, a55, m0, sweet_osm[1].cpu, a76, m1);
+	if (sweet_osm[0].osm != 0 && sweet_osm[1].osm != 0) {
+		printf("SWEET CPUFREQ: %s: LMh cap A55 %u MHz A76 %u MHz, perf state A55 %u/%u A76 %u/%u L3 %u/%u\n", when,
+		    (rd32(sweet_osm[0].lmh + LMH_CAP) & 0x3ff) * 192 / 10, (rd32(sweet_osm[1].lmh + LMH_CAP) & 0x3ff) * 192 / 10,
+		    rd32(sweet_osm[0].osm + OSM_PERF_STATE(0)), sweet_osm[0].top,
+		    rd32(sweet_osm[1].osm + OSM_PERF_STATE(0)), sweet_osm[1].top,
+		    sweet_osm[2].osm != 0 ? rd32(sweet_osm[2].osm + OSM_PERF_STATE(0)) : 0, sweet_osm[2].top);
+	}
+}
+
+/* Read one OSM look-up table (Linux clk_osm_read_lut / osm_cpufreq_cpu_init): two equal rows end it. */
+static void
+sweet_cpufreq_lut(struct sweet_osm *c)
+{
+	uint32_t prev = 0;
+
+	c->osm = ml_io_map(c->osm_pa, OSM_SIZE);
+	if (c->lmh_pa != 0) {
+		c->lmh = ml_io_map(c->lmh_pa, LMH_SIZE);
+	}
+	c->per_core = c->cores > 1 && (rd32(c->osm + OSM_CORE_DCVS_CTRL) & 1) != 0;
+	for (unsigned i = 0; i < OSM_TABLE_SIZE; i++) {
+		uint32_t f = rd32(c->osm + OSM_FREQ_REG(i));
+		uint32_t v = rd32(c->osm + OSM_VOLT_REG(i));
+		uint32_t mhz = (f >> 30) != 0 ? (f & 0xff) * 192 / 10 : 300;
+		unsigned cores = (f >> 16) & 7;
+
+		if (i > 0 && mhz == prev) {
+			break;
+		}
+		printf("SWEET CPUFREQ: %s lut %u: %u MHz, cores %u, corner %u, %u mV (raw 0x%08x 0x%08x)\n",
+		    c->name, i, mhz, cores, (v >> 16) & 0x3f, v & 0xfff, f, v);
+		c->entries = i + 1;
+		if (!c->boost_rows || cores != 1) {     /* one-core rows are boost: Linux leaves them out by default */
+			c->top = i;
+			c->top_mhz = mhz;
+		}
+		prev = mhz;
+	}
+	printf("SWEET CPUFREQ: %s: %u rows, top non-boost row %u = %u MHz, per-core requests %d, now at row %u\n",
+	    c->name, c->entries, c->top, c->top_mhz, c->per_core, rd32(c->osm + OSM_PERF_STATE(0)));
+}
+
+static void
+sweet_cpufreq_raise(struct sweet_osm *c)
+{
+	/* A table that does not look like one (unreadable, all zero) would make "top" a low row: never go down. */
+	if (c->entries < 4 || c->top_mhz < 1000 || rd32(c->osm + OSM_PERF_STATE(0)) >= c->top) {
+		printf("SWEET CPUFREQ: %s: left alone\n", c->name);
+		return;
+	}
+	for (unsigned n = 0; n < (c->per_core ? c->cores : 1); n++) {
+		wr32(c->osm + OSM_PERF_STATE(n), c->top);
+	}
+	(void)rd32(c->osm + OSM_ENABLE_REG);    /* Linux clk_osm_mb: the write is through */
+	printf("SWEET CPUFREQ: %s: requested row %u (%u MHz)\n", c->name, c->top, c->top_mhz);
+}
+
+static void
+sweet_cpufreq_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	uint32_t period = 30;
+
+	PE_parse_boot_argn("sweetcpufreq", &sweet_cpufreq_mode, sizeof(sweet_cpufreq_mode));
+	PE_parse_boot_argn("sweetcpufreq_ro", &sweet_cpufreq_ro, sizeof(sweet_cpufreq_ro));
+	PE_parse_boot_argn("sweetcpufreq_log", &period, sizeof(period));
+	/* MPIDR Aff1 0-5 = A55, 6-7 = A76 (SweetCPU.cpp) */
+	for (unsigned i = 0; i < topology->num_cpus; i++) {
+		struct sweet_osm *c = &sweet_osm[topology->cpus[i].phys_id >= 0x600 ? 1 : 0];
+		if (c->cpu < 0) {
+			c->cpu = (int)topology->cpus[i].cpu_id;
+		}
+	}
+	if (sweet_cpufreq_mode > 0) {
+		sweet_cpufreq_lut(&sweet_osm[0]);
+		sweet_cpufreq_lut(&sweet_osm[1]);
+		sweet_cpufreq_lut(&sweet_osm[2]);
+	}
+	sweet_cpufreq_report("boot");
+	if (sweet_cpufreq_mode > 0 && !sweet_cpufreq_ro) {
+		sweet_cpufreq_raise(&sweet_osm[0]);
+		sweet_cpufreq_raise(&sweet_osm[1]);
+		if (sweet_cpufreq_mode > 1) {
+			sweet_cpufreq_raise(&sweet_osm[2]);
+		}
+		delay_for_interval(50, (uint32_t)NSEC_PER_MSEC);
+		sweet_cpufreq_report("raised");
+	}
+	while (period != 0) {
+		delay_for_interval(period * 1000, (uint32_t)NSEC_PER_MSEC);
+		sweet_cpufreq_report("now");
+	}
+}
+
+void
+sweet_cpufreq_start(void)
+{
+	thread_t thread;
+
+	if (kernel_thread_start(sweet_cpufreq_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* SWEET */
