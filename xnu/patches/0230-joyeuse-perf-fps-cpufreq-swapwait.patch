+/* The frame-rate yardstick: one line per period while anything is drawn, nothing while idle. Vsync thread. */
+void
+AppleCLCD::statTick(uint64_t now)
+{
+	if (fStatPeriod == 0 || now - fStatStart < fStatPeriod) {
+		return;
+	}
+	IOLockLock(fLock);
+	uint32_t swaps = fStatSwaps, dropped = fStatDropped;
+	fStatSwaps = fStatDropped = 0;
+	IOLockUnlock(fLock);
+	uint32_t waits = __atomic_exchange_n(&fStatWaits, 0, __ATOMIC_RELAXED);
+	uint32_t waitsOld = __atomic_exchange_n(&fStatWaitsOld, 0, __ATOMIC_RELAXED);
+	uint32_t waitsTimeout = __atomic_exchange_n(&fStatWaitsTimeout, 0, __ATOMIC_RELAXED);
+	uint64_t waitSum = __atomic_exchange_n(&fStatWait, 0, __ATOMIC_RELAXED);
+	uint64_t waitMax = __atomic_exchange_n(&fStatWaitMax, 0, __ATOMIC_RELAXED);
+	uint64_t ms = sweet_fb_us(now - fStatStart) / 1000ULL;
+
+	if ((swaps != 0 || fStatPresents != 0) && ms != 0) {
+		uint64_t p10 = (uint64_t)fStatPresents * 10000ULL / ms, s10 = (uint64_t)swaps * 10000ULL / ms;
+		IOLog("SWEET FPS: %llu.%llu presents/s, swaps %llu.%llu/s, dropped %u, copy avg %llu max %llu us, "
+		    "rows changed %llu%%, panel %llu MB/s, vsync late avg %llu max %llu us (%u ticks), "
+		    "swapwait n %u older %u timeout %u avg %llu max %llu us, shadow %d\n",
+		    p10 / 10, p10 % 10, s10 / 10, s10 % 10, dropped,
+		    fStatPresents ? sweet_fb_us(fStatCopy) / fStatPresents : 0, sweet_fb_us(fStatCopyMax),
+		    fStatRows ? fStatRowsChanged * 100ULL / fStatRows : 0, fStatBytes / 1000ULL / ms,
+		    fStatTicks ? sweet_fb_us(fStatLate) / fStatTicks : 0, sweet_fb_us(fStatLateMax), fStatTicks,
+		    waits, waitsOld, waitsTimeout, waits ? sweet_fb_us(waitSum) / waits : 0, sweet_fb_us(waitMax),
+		    fStatShadow);
+	}
+	fStatPresents = fStatTicks = 0;
+	fStatCopy = fStatCopyMax = fStatLate = fStatLateMax = 0;
+	fStatRows = fStatRowsChanged = fStatBytes = 0;
+	fStatStart = now;
+}
