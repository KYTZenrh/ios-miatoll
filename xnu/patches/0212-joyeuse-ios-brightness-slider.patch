+/*
+ * 0212: iOS brightness. backboardd (CoreBrightness) looks once for a service with backlight-control = true
+ * ("IOK backboardd: matching ... backlight-control ... -> 0 found"); the iPhone X kernelcache matches its
+ * AppleARMBacklight on exactly that, and backboardd's sandbox lets it set brightness-nits, DisplayBrightness* on
+ * AppleARMBacklight and IOMFBBrightnessLevel (IOFixed 16.16 nits) on AppleCLCD. Both nits keys are taken as 16.16
+ * nits, linear to the WLED current; every key backboardd sets is logged so the real protocol shows in the log.
+ */
+#define SWEET_BL_MAX_NITS               500     /* iPhone X SDR maximum -> full WLED current */
+
+class AppleARMBacklight : public IOService {
+	OSDeclareDefaultStructors(AppleARMBacklight);
+public:
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleARMBacklight, IOService);
+
+static uint32_t sweet_bl_props_count;
+
+static IOReturn
+sweet_bl_set_properties(const char *who, OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	if (dict == NULL) {
+		return kIOReturnBadArgument;
+	}
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	const char *pname = name;       /* a block cannot capture the array */
+	uint32_t n = ++sweet_bl_props_count;
+	bool verbose = n <= 64 || (n % 64) == 0;
+	IOReturn ret __block = kIOReturnUnsupported;
+	dict->iterateObjects(^bool (const OSSymbol *key, OSObject *value) {
+		OSNumber *num = OSDynamicCast(OSNumber, value);
+		if (verbose) {
+			IOLog("SWEET BL: %s sets %s %s = %s 0x%llx (#%u)\n", pname, who, key->getCStringNoCopy(),
+			    value->getMetaClass()->getClassName(), num != NULL ? num->unsigned64BitValue() : 0ULL, n);
+		}
+		if (num != NULL && (key->isEqualTo("IOMFBBrightnessLevel") || key->isEqualTo("brightness-nits"))) {
+			uint64_t level = num->unsigned64BitValue() * 4095ULL / ((uint64_t)SWEET_BL_MAX_NITS << 16);
+			sweet_backlight_set(level > 4095 ? 4095 : (int)level);
+			ret = kIOReturnSuccess;
+		}
+		return false;
+	});
+	return ret;
+}
+
+IOReturn
+AppleARMBacklight::setProperties(OSObject *properties)
+{
+	return sweet_bl_set_properties("AppleARMBacklight", properties);
+}
+
+IOReturn
+AppleCLCD::setProperties(OSObject *properties)
+{
+	return sweet_bl_set_properties("AppleCLCD", properties);
+}
+
