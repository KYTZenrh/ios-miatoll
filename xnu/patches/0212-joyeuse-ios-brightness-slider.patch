 	registerService();
+	/* 0212: the backlight service backboardd looks for; boot-arg sweetblnub=0 leaves it out */
+	int blnub = 1;
+	PE_parse_boot_argn("sweetblnub", &blnub, sizeof(blnub));
+	AppleARMBacklight *bl = blnub ? OSTypeAlloc(AppleARMBacklight) : NULL;
+	if (bl != NULL && bl->init() && bl->attach(this)) {
+		bl->setName("backlight");
+		bl->setProperty("backlight-control", true);
+		bl->registerService();
+		IOLog("SWEET BL: AppleARMBacklight published\n");
+	}
+	OSSafeReleaseNULL(bl);
 	IOLog("SWEET FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, presented as %ux%u\n",
 	    fWidth, fHeight, fRowBytes, fPhys, fSurface->id, fLogicalW, fLogicalH);
