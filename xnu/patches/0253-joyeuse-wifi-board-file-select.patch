diff --git a/bsd/dev/sweet_modem.inc b/bsd/dev/sweet_modem.inc
index 790535a..a19ddbd 100644
--- a/bsd/dev/sweet_modem.inc
+++ b/bsd/dev/sweet_modem.inc
@@ -2392,7 +2392,14 @@ wlfw_bdf_download(uint32_t board_id)
 {
 	char name[16];
 	vnode_t vp = NULLVP;
-	snprintf(name, sizeof(name), "BDWLAN.B%02X", board_id & 0xff);
+	/* 0253: the firmware reports no board id on joyeuse (0xff -> generic BDWLAN.BIN); sweetwlboard=<id> picks a board file.
